---
import { profile } from "../lib/profile";

interface Props {
  className: string;
}

const { className } = Astro.props as Props;
---

<section class={className}>
  <article class="profile-panel">
    <h2>Current focus</h2>
    <p>
      I am now working at Open Government Products building for public good.
    </p>
  </article>
  <article class="profile-panel">
    <h2>Technical stack</h2>
    <dl class="stack-groups">
      {
        profile.stackGroups.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>
              <ul class="chip-list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </article>
</section>
