---
import { focusAreas, profile } from "../lib/profile";

interface Props {
  className: string;
}

const { className } = Astro.props as Props;
---

<section class={className}>
  <article class="profile-panel">
    <h2>Current focus</h2>
    <p>
      I am now working at Open Government Products building for public good.
    </p>
    <ul class="chip-list">
      {focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </article>
  <article class="profile-panel">
    <h2>Technical stack</h2>
    <ul class="chip-list">
      {profile.stack.map((item) => <li>{item}</li>)}
    </ul>
  </article>
</section>
