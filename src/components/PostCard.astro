---
import type { CollectionEntry } from "astro:content";
import { articleWordCount, getPostHref, readingTime } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const words = articleWordCount(post);
---

<article class="post-card">
  <div class="post-card-top">
    <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })}</time>
    <span>{readingTime(words)} min</span>
  </div>
  <h2><a href={getPostHref(post.id)}>{post.data.title}</a></h2>
  {post.data.description && <p>{post.data.description}</p>}
</article>
