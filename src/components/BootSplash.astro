---
const buildDate = new Date();
const pad = (value: number) => String(value).padStart(2, "0");
const buildVersion = `v${buildDate.getFullYear()}.${pad(buildDate.getMonth() + 1)}.${pad(buildDate.getDate())}`;
---

<section
  class="boot-splash"
  aria-label="TiewOS boot screen"
  role="status"
  aria-live="polite"
  data-boot-splash
>
  <div class="boot-panel">
    <div class="boot-logo-shell" aria-hidden="true">
      <img src="/assets/img/logo.png" alt="" />
      <span class="boot-ring"></span>
    </div>
    <div class="boot-copy">
      <p class="boot-kicker">TiewOS</p>
      <h1>Starting machine</h1>
      <ol class="boot-checks" aria-hidden="true">
        <li>kernel: portfolio</li>
        <li>version: {buildVersion}</li>
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const ring = document.querySelector(".boot-ring");
    if (!ring) return;
    const duration = 2000;
    ring.style.setProperty("--boot-duration", `${duration}ms`);
    window.__tiewosBootDurationMs = duration;
  })();
</script>
