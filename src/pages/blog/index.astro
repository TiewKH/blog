---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingBrowser from "../../components/WritingBrowser.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BaseLayout title="Blog">
  <section class="page-heading writing-heading">
    <h1>Technical notes and engineering writeups.</h1>
    <p>Code-heavy posts, data explorations, visualization experiments, and machine learning notes.</p>
  </section>

  <WritingBrowser posts={posts} />

</BaseLayout>
