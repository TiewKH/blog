---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/ContactSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import ProfileIntro from "../components/ProfileIntro.astro";
import ProfilePanels from "../components/ProfilePanels.astro";
import SocialIcon from "../components/SocialIcon.astro";
import WritingSection from "../components/WritingSection.astro";
import { render } from "astro:content";
import {
  articleWordCount,
  getPosts,
  getPostHref,
  readingTime,
} from "../lib/posts";
import { profile } from "../lib/profile";

const posts = await getPosts();
const articleEntries = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    const words = articleWordCount(post);
    return { post, Content, href: getPostHref(post.id), words };
  }),
);
---

<BaseLayout>
  <section class="os-home" aria-label="OS homepage">
    <div class="os-menubar">
      <a class="os-brand" href="/" aria-label="Home">
        <img class="os-brand-logo" src="/assets/img/logo.png" alt="" />
      </a>
      <button type="button" data-open-window="readme">About</button>
      <button type="button" data-open-window="writing">Writing</button>
      <button type="button" data-open-window="contact">Contact</button>
      <div class="mode-toggle" role="group" aria-label="Display mode">
        <button type="button" data-mode-choice="website">
          <span aria-hidden="true">[]</span>
          Website
        </button>
        <button type="button" data-mode-choice="os">
          <span aria-hidden="true">/</span>
          OS
        </button>
      </div>
    </div>

    <div class="desktop-grid">
      <aside class="desktop-dock" aria-label="OS apps">
        <button
          class="desktop-icon active"
          type="button"
          data-open-window="readme"
        >
          <span class="icon-file">M</span>
          README.md
        </button>
        <button class="desktop-icon" type="button" data-open-window="writing">
          <span class="icon-file pen">P</span>
          Writing.app
        </button>
        <a
          class="desktop-icon external-link"
          href={profile.resume}
          data-link-kind="external"
        >
          <span class="icon-file pdf">PDF</span>
          <span class="external-indicator" aria-hidden="true">open</span>
          Resume.pdf
        </a>
        <a
          class="desktop-icon external-link"
          href={profile.github}
          data-link-kind="external"
        >
          <span class="icon-file social" aria-hidden="true"
            ><SocialIcon icon="github" /></span
          >
          <span class="external-indicator" aria-hidden="true">ext</span>
          GitHub
        </a>
        <a
          class="desktop-icon external-link"
          href={profile.linkedin}
          data-link-kind="external"
        >
          <span class="icon-file social" aria-hidden="true"
            ><SocialIcon icon="linkedin" /></span
          >
          <span class="external-indicator" aria-hidden="true">ext</span>
          LinkedIn
        </a>
        <button class="desktop-icon" type="button" data-open-window="contact">
          <span class="icon-file chat">C</span>
          Contact.app
        </button>
      </aside>

      <section
        class="window-frame readme-window"
        aria-labelledby="readme-title"
        data-window-id="readme"
      >
        <header class="window-bar">
          <span class="traffic-lights" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <strong>README.md</strong>
          <span class="window-actions">
            <button
              class="window-control"
              type="button"
              data-window-action="maximize"
              aria-label="Maximize README.md">□</button
            >
            <button
              class="window-control close"
              type="button"
              data-window-action="close"
              aria-label="Close README.md">×</button
            >
          </span>
        </header>
        <div class="window-body readme-body">
          <ProfileIntro variant="readme" titleId="readme-title" />
          <ProfilePanels className="readme-profile-grid" />
          <ExperienceSection
            className="readme-experience-section"
            titleId="readme-experience-title"
          />
        </div>
        <span
          class="window-resize-handle right"
          data-window-resize="right"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle bottom"
          data-window-resize="bottom"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle corner"
          data-window-resize="corner"
          aria-hidden="true"></span>
      </section>

      <aside
        class="window-frame side-window writing-window"
        aria-label="Writing app preview"
        data-window-id="writing"
      >
        <header class="window-bar compact">
          <strong>Writing.app</strong>
          <span class="window-actions">
            <button
              class="window-control"
              type="button"
              data-window-action="maximize"
              aria-label="Maximize Writing.app">□</button
            >
            <button
              class="window-control close"
              type="button"
              data-window-action="close"
              aria-label="Close Writing.app">×</button
            >
          </span>
        </header>
        <div class="window-body writing-app-body">
          <WritingSection posts={posts} headingClass="window-writing-heading" />
        </div>
        <span
          class="window-resize-handle right"
          data-window-resize="right"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle bottom"
          data-window-resize="bottom"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle corner"
          data-window-resize="corner"
          aria-hidden="true"></span>
      </aside>

      <aside
        class="window-frame article-window"
        aria-label="Article reader"
        data-window-id="article"
        data-article-reader
      >
        <header class="window-bar compact">
          <strong data-article-window-title>Article.md</strong>
          <span class="window-actions">
            <button
              class="window-control"
              type="button"
              data-window-action="maximize"
              aria-label="Maximize Article.md">[]</button
            >
            <button
              class="window-control close"
              type="button"
              data-window-action="close"
              aria-label="Close Article.md">X</button
            >
          </span>
        </header>
        <div class="window-body article-window-body">
          {
            articleEntries.map(({ post, Content, href, words }) => (
              <article
                class="post-shell article-window-content"
                data-article-content={href}
                hidden
              >
                <header class="post-hero">
                  <h1>{post.data.title}</h1>
                  {post.data.description && (
                    <p class="lede">{post.data.description}</p>
                  )}
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString("en", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                    <span>{readingTime(words)} min read</span>
                  </div>
                </header>
                {post.data.image && (
                  <figure class="featured-media">
                    <img src={`/assets/img/${post.data.image}`} alt="" />
                  </figure>
                )}
                <div class="post-content">
                  <Content />
                </div>
              </article>
            ))
          }
        </div>
        <span
          class="window-resize-handle right"
          data-window-resize="right"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle bottom"
          data-window-resize="bottom"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle corner"
          data-window-resize="corner"
          aria-hidden="true"></span>
      </aside>

      <aside
        class="window-frame contact-window"
        aria-label="Contact app"
        data-window-id="contact"
      >
        <header class="window-bar compact">
          <strong>Contact.app</strong>
          <span class="window-actions">
            <button
              class="window-control"
              type="button"
              data-window-action="maximize"
              aria-label="Maximize Contact.app">â–¡</button
            >
            <button
              class="window-control close"
              type="button"
              data-window-action="close"
              aria-label="Close Contact.app">X</button
            >
          </span>
        </header>
        <div class="window-body">
          <ContactSection className="contact-window-layout" idPrefix="os" />
        </div>
        <span
          class="window-resize-handle right"
          data-window-resize="right"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle bottom"
          data-window-resize="bottom"
          aria-hidden="true"></span>
        <span
          class="window-resize-handle corner"
          data-window-resize="corner"
          aria-hidden="true"></span>
      </aside>

      <div class="snap-indicator" data-snap-indicator hidden></div>
    </div>
  </section>

  <ProfileIntro variant="website" />
  <ProfilePanels className="profile-grid website-home" />
  <ExperienceSection
    className="experience-section website-home"
    titleId="experience-title"
  />

  <script>
    import "../scripts/os-window-manager.ts";
  </script>
</BaseLayout>
