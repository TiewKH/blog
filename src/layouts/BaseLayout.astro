---
import "../styles/global.css";
import BootSplash from "../components/BootSplash.astro";
import DesktopAppIcon from "../components/DesktopAppIcon.astro";
import ExternalLinkMark from "../components/ExternalLinkMark.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { profile, siteTitle } from "../lib/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteTitle,
  description = "Machine learning, data systems, fullstack engineering notes, and technical writing.",
} = Astro.props;
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/";
const shouldLoadGoogleAnalytics = import.meta.env.PROD;
const googleAnalyticsScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-89L9XET7YL");
`;
const osWindowTitle = currentPath.startsWith("/blog/")
  ? "Writing.app"
  : currentPath.startsWith("/about/")
    ? "README.md"
    : currentPath.startsWith("/contact/")
      ? "Contact.app"
      : "Website.app";
const bodyClassName = [
  isHomePage ? "home-page" : undefined,
  !isHomePage ? "os-subpage" : undefined,
  !isHomePage
    ? `os-app-${osWindowTitle.replace(/\W+/g, "-").replace(/-$/, "").toLowerCase()}`
    : undefined,
]
  .filter(Boolean)
  .join(" ");

const navItems = [
  { href: "/", label: "About" },
  { href: "/blog/", label: "Writings" },
  { href: "/contact/", label: "Contact" },
];

const socialLinks = [
  {
    href: profile.github,
    label: "GitHub",
    icon: "github",
  },
  {
    href: profile.linkedin,
    label: "LinkedIn",
    icon: "linkedin",
  },
] as const;
---

<!doctype html>
<html lang="en" data-mode="os">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {
      shouldLoadGoogleAnalytics && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-89L9XET7YL"
          />
          <script is:inline set:html={googleAnalyticsScript} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@400;600&family=Recursive:wght@500;700;900&display=swap"
    />
    <link rel="icon" href="/assets/img/favicon_io/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/img/favicon_io/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/img/favicon_io/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/img/favicon_io/apple-touch-icon.png"
    />
    <link rel="manifest" href="/assets/img/favicon_io/site.webmanifest" />
    <meta name="theme-color" content="#f6fbfa" />
    <slot name="head" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const key = "tiewosBootSplashShown:v1";
        const root = document.documentElement;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        try {
          if (window.sessionStorage.getItem(key) === "true") return;
          root.dataset.bootSplash = reducedMotion ? "reduced" : "pending";
        } catch {
          root.dataset.bootSplash = reducedMotion ? "reduced" : "pending";
        }
      })();
    </script>
    <script>
      import "../scripts/base-layout.js";
    </script>
  </head>
  <body class={bodyClassName || undefined}>
    <BootSplash />
    {
      !isHomePage && (
        <section class="os-page-shell" aria-label="OS mode">
          <div class="os-menubar">
            <a class="os-brand" href="/" aria-label="Home">
              <img class="os-brand-logo" src="/assets/img/logo.png" alt="" />
            </a>
            <a href="/blog/" data-os-app-link="writing">
              Writing
            </a>
            <a href="/" data-os-app-link="readme">
              About
            </a>
            <a href="/contact/" data-os-app-link="contact">
              Contact
            </a>
            <div class="mode-toggle" role="group" aria-label="Display mode">
              <button type="button" data-mode-choice="website">
                <span aria-hidden="true">[]</span>
                Website
              </button>
              <button type="button" data-mode-choice="os">
                <span aria-hidden="true">/</span>
                OS
              </button>
            </div>
          </div>
          <aside class="desktop-dock os-page-dock" aria-label="Desktop links">
            <a class="desktop-icon" href="/blog/" data-os-app-link="writing">
              <DesktopAppIcon icon="writing" />
              Writing.app
            </a>
            <a
              class="desktop-icon external-link"
              href={profile.resume}
              data-link-kind="external"
            >
              <span class="icon-file pdf">PDF</span>
              <ExternalLinkMark />
              Resume.pdf
            </a>
            <a
              class="desktop-icon external-link"
              href={profile.github}
              data-link-kind="external"
            >
              <span class="icon-file social" aria-hidden="true">
                <SocialIcon icon="github" />
              </span>
              <ExternalLinkMark />
              GitHub
            </a>
            <a
              class="desktop-icon external-link"
              href={profile.linkedin}
              data-link-kind="external"
            >
              <span class="icon-file social" aria-hidden="true">
                <SocialIcon icon="linkedin" />
              </span>
              <ExternalLinkMark />
              LinkedIn
            </a>
            <a class="desktop-icon" href="/contact/" data-os-app-link="contact">
              <DesktopAppIcon icon="contact" />
              Contact.app
            </a>
          </aside>
        </section>
      )
    }
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home">
        <span class="brand-mark">
          <img src="/assets/img/logo.png" alt="" />
        </span>
        <span>
          <strong>{profile.name}</strong>
          <small>{profile.role}</small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={
                (
                  item.href === "/"
                    ? currentPath === "/" || currentPath.startsWith("/about/")
                    : currentPath.startsWith(item.href)
                )
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mode-toggle" role="group" aria-label="Display mode">
        <button type="button" data-mode-choice="website">
          <span aria-hidden="true">[]</span>
          Website
        </button>
        <button type="button" data-mode-choice="os">
          <span aria-hidden="true">/</span>
          OS
        </button>
      </div>
    </header>
    <main class="site-main" data-os-window-title={osWindowTitle}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-links" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              class="icon-link"
              href={link.href}
              aria-label={link.label}
              title={link.label}
            >
              <SocialIcon icon={link.icon} />
            </a>
          ))
        }
      </div>
    </footer>
  </body>
</html>
