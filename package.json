{
  "name": "blog-modern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "format": "prettier \"**/*.{astro,css,js,json,jsonc,md,mjs,ts,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{astro,css,js,json,jsonc,md,mjs,ts,yml,yaml}\" --check",
    "lint": "astro check",
    "preview": "astro preview",
    "sort": "sort-package-json package.json",
    "test": "pnpm test:reading-time && pnpm test:os",
    "test:os": "node scripts/verify-os-window-behavior.mjs",
    "test:reading-time": "node scripts/verify-reading-time.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "lefthook": "^2.1.9",
    "pagefind": "^1.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.4"
}
